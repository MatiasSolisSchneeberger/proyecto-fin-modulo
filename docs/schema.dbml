// ======================================================================
// Tracker Cronológico del UCM y Multiverso (PostgreSQL)
// Modelo Relacional DBML para dbdiagram.io
// ======================================================================

// --- ENUMS ---

enum watch_status {
    watched // Visto
    skipped // Salteado (ej: no le interesa ver este especial o corto)
}

// --- TABLAS DE CONFIGURACIÓN Y CATÁLOGO ---

Table production_studios {
    id int [pk, increment]
    name varchar(100) [not null, unique, note: 'Marvel Studios, Sony, Fox, ABC, etc.']
    description text

    Note: 'Estudios de producción'
}

Table platforms {
    id int [pk, increment]
    name varchar(100) [not null, unique, note: 'Disney+, Cine, Netflix, ABC, etc.']
    website_url varchar(255)

    Note: 'Plataformas o medios de emisión original'
}

Table movie_types {
    id int [pk, increment]
    name varchar(50) [not null, unique, note: 'Película (default), One-Shot, Especial']
    description text

    Note: 'Clasificación de obras autoconclusivas (Película, One-Shot, Especial)'
}

Table tag_categories {
    id int [pk, increment]
    name varchar(50) [not null, unique, note: 'General (default), Universos/Tierras, Personajes, Equipos, Fases, Sagas']
    description text

    Note: 'Categorías dinámicas para tags (permite crear nuevas sin alterar enums)'
}

// --- USUARIOS ---

Table users {
    id uuid [pk, default: `gen_random_uuid()`, note: 'UUID nativo de PostgreSQL']
    username varchar(50) [not null, unique]
    email varchar(255) [not null, unique]
    password_hash varchar(255) [not null]
    created_at timestamptz [not null, default: `now()`]
    updated_at timestamptz [not null, default: `now()`]

    Note: 'Usuarios registrados para tracking de visualización'
}

// --- SERIES DE TELEVISIÓN (Contenedor lógico de temporadas y episodios) ---

Table series {
    id int [pk, increment]
    title varchar(255) [not null, note: 'Título de la serie (ej: Daredevil, Loki)']
    release_date date [not null, note: 'Fecha de estreno del primer episodio o temporada']
    poster_url text
    synopsis text
    created_at timestamptz [not null, default: `now()`]
    updated_at timestamptz [not null, default: `now()`]

    Note: 'Entidad de serie para marcar temporadas o series enteras'
}

// --- JERARQUÍA MEDIA (Unidades cronológicas consumibles) ---

Table media {
    id int [pk, increment]
    order_key varchar(255) [not null, unique, note: 'Fractional Indexing: define el orden absoluto en la línea de tiempo']
    duration_minutes int [not null, note: 'Duración exacta consumible en minutos (NOT NULL)']
    created_at timestamptz [not null, default: `now()`]
    updated_at timestamptz [not null, default: `now()`]

    indexes {
        order_key [name: 'idx_media_order_key']
    }

    Note: 'TABLA PADRE: Toda unidad visualizable individual en la cronología'
}

Table movies {
    media_id int [pk, ref: - media.id, note: '1 a 1 estricto con media.id']
    movie_type_id int [not null, ref: > movie_types.id, note: 'Tipo de producción: Película por defecto, One-Shot, Especial']
    title varchar(255) [not null, note: 'Título de la película, corto o especial']
    release_date date [not null, note: 'Fecha de estreno original']
    poster_url text
    synopsis text

    Note: 'Películas, One-Shots (cortos) y Especiales'
}

Table episodes {
    media_id int [pk, ref: - media.id, note: '1 a 1 estricto con media.id']
    series_id int [pk, not null, ref: > series.id, note: 'Serie a la que pertenece obligatoriamente']
    season_number int [not null, note: 'Temporada (ej: 1)']
    episode_number int [not null, note: 'Número de episodio (ej: 5)']
    title varchar(255) [not null, note: 'Título del capítulo']
    air_date date [not null, note: 'Fecha de emisión original del capítulo']

    indexes {
        (series_id, season_number, episode_number) [unique]
        series_id [name: 'idx_episodes_series']
    }

    Note: 'Episodios individuales de series'
}

Table post_credits_scenes {
    media_id int [pk, ref: - media.id, note: '1 a 1 estricto con media.id']
    source_movie_id int [not null, ref: > movies.media_id, note: 'Película de origen a la que pertenece esta escena']
    description varchar(255) [not null, note: 'Identificador contextual de la escena']

    Note: 'Escenas post-créditos desvinculadas temporalmente con su propia posición cronológica'
}

// --- RELACIONES M:N DE MEDIA CON PRODUCTORAS Y PLATAFORMAS ---

Table media_production_studios {
    media_id int [not null, ref: > media.id]
    studio_id int [not null, ref: > production_studios.id]

    indexes {
        (media_id, studio_id) [pk]
    }

    Note: 'Relación M:N: un media puede tener múltiples productoras (ej: Marvel Studios + Sony)'
}

Table media_platforms {
    media_id int [not null, ref: > media.id]
    platform_id int [not null, ref: > platforms.id]

    indexes {
        (media_id, platform_id) [pk]
    }

    Note: 'Relación M:N: un media puede estar disponible en múltiples plataformas (ej: Cine, Disney+)'
}

// --- NOTAS (Markdown enriquecido con flag de spoilers) ---

Table media_notes {
    id int [pk, increment]
    media_id int [not null, ref: > media.id]
    content text [not null, note: 'Contenido en Markdown (permite negritas, links, formato enriquecido)']
    is_spoiler boolean [not null, default: false, note: 'Indica si la nota revela spoilers de la trama']
    order_index int [not null, default: 0, note: 'Orden si hay varias notas para el mismo media']
    created_at timestamptz [not null, default: `now()`]

    indexes {
        media_id [name: 'idx_notes_media']
    }

    Note: 'Notas y recomendaciones contextuales para el espectador'
}

// --- TAXONOMÍA Y SISTEMA DE TAGS M:N (Con Spoilers) ---

Table tags {
    id int [pk, increment]
    category_id int [not null, ref: > tag_categories.id, note: 'Categoría dinámica (default General)']
    slug varchar(100) [not null, unique, note: 'Identificador único (ej: earth-616, red-skull, fase-1)']
    name varchar(100) [not null, note: 'Nombre legible (ej: Earth-616 (MCU), Red Skull, Fase 1)']
    description text

    indexes {
        category_id [name: 'idx_tags_category']
    }

    Note: 'Etiquetas dinámicas clasificadas por categoría en tabla'
}

Table media_tags {
    media_id int [not null, ref: > media.id]
    tag_id int [not null, ref: > tags.id]
    is_spoiler boolean [not null, default: false, note: 'Indica si asociar esta etiqueta a este media es spoiler (ej: Red Skull en Infinity War)']

    indexes {
        (media_id, tag_id) [pk]
        tag_id [name: 'idx_media_tags_tag']
    }

    Note: 'Relación M:N entre medios y etiquetas con flag de spoiler contextual'
}

// --- SEGUIMIENTO Y TRACKING DE USUARIO (Watched / Skipped) ---

Table user_watch_progress {
    id uuid [pk, default: `gen_random_uuid()`]
    user_id uuid [not null, ref: > users.id]
    media_id int [not null, ref: > media.id]
    status watch_status [not null, default: 'watched', note: 'watched (visto) o skipped (salteado)']
    created_at timestamptz [not null, default: `now()`, note: 'Fecha y hora en que se marcó']

    indexes {
        (user_id, media_id) [unique]
        user_id [name: 'idx_user_progress_user']
    }

    Note: 'Registro atómico de tracking (la ausencia del registro indica pendiente/no visto)'
}
