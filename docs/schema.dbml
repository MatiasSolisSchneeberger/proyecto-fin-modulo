// ======================================================================
// Tracker Cronológico del UCM y Multiverso (PostgreSQL)
// Modelo Relacional DBML para dbdiagram.io  ·  v2
//
// Idea central: separar tres cosas que antes vivían mezcladas en `media`
//   1. OBRA            (titles)          -> metadata global, se edita en UN solo lugar
//   2. ÍTEM            (timeline_items)  -> lo que se mira y se marca como visto
//   3. POSICIÓN        (timeline_entries)-> dónde cae el ítem en un orden dado
// ======================================================================

// --- ENUMS ---

enum title_kind {
    movie    // Película
    series   // Serie (contenedor de episodios, no se mira directamente)
    short    // Corto / One-Shot
    special  // Especial de TV / streaming
}

enum item_segment {
    full          // Obra completa en un solo bloque (película, corto, especial)
    main          // Cuerpo principal de una película partida en segmentos
    post_credits  // Escena de créditos / post-créditos con posición propia
    bonus         // Re-release, cut alternativo, extras (ej: "Endgame | Re-Release")
    episode       // Episodio de una serie
}

enum watch_status {
    watched // Visto
    skipped // Salteado (no le interesa ver este especial o corto)
}

enum role_user {
    user
    admin
}

// --- CATÁLOGOS ---

Table universes {
    id int [pk, increment]
    code varchar(50) [not null, unique, note: 'Identificador canónico: Earth-616, Earth-10005, Earth-TRN414...']
    name varchar(150) [not null, note: 'Nombre legible: MCU, X-Men, Super Soldier Peggy Carter...']
    description text

    Note: 'Universos / realidades del multiverso. Cada ítem pertenece a EXACTAMENTE uno (FK obligatoria, no un tag)'
}

Table production_studios {
    id int [pk, increment]
    name varchar(100) [not null, unique, note: 'Marvel Studios, Sony, Fox, ABC, etc.']
    description text

    Note: 'Estudios de producción'
}

Table platforms {
    id int [pk, increment]
    name varchar(100) [not null, unique, note: 'Disney+, Cine, Netflix, ABC, etc.']
    website_url varchar(255)

    Note: 'Plataformas o medios de emisión original'
}

Table tag_categories {
    id int [pk, increment]
    name varchar(50) [not null, unique, note: 'General (default), Personajes, Equipos, Fases, Sagas']
    description text

    Note: 'Categorías dinámicas para tags (permite crear nuevas sin alterar enums). Los universos YA NO son tags'
}

Table tags {
    id int [pk, increment]
    category_id int [not null, ref: > tag_categories.id, note: 'ON DELETE RESTRICT']
    slug varchar(100) [not null, unique, note: 'Identificador único (ej: red-skull, fase-1)']
    name varchar(100) [not null, note: 'Nombre legible (ej: Red Skull, Fase 1)']
    description text

    indexes {
        category_id [name: 'idx_tags_category']
    }

    Note: 'Etiquetas dinámicas clasificadas por categoría'
}

// --- USUARIOS ---

Table users {
    id uuid [pk, default: `gen_random_uuid()`, note: 'UUID nativo de PostgreSQL']
    username varchar(50) [not null, unique]
    email varchar(255) [not null, note: 'UNIQUE sobre lower(email) para no distinguir mayúsculas']
    password varchar(255) [not null, note: 'Hash bcrypt, nunca se devuelve en las queries']
    role role_user [default: 'user', not null]
    created_at timestamptz [not null, default: `now()`]
    updated_at timestamptz [not null, default: `now()`, note: 'Drizzle: .$onUpdate(() => new Date())']

    indexes {
        `lower(email)` [unique, name: 'uq_users_email_lower']
    }

    Note: 'Usuarios registrados para tracking de visualización'
}

// --- 1. OBRA (metadata global) ---

Table titles {
    id int [pk, increment]
    kind title_kind [not null]
    title varchar(255) [not null, note: 'Título oficial (ej: Iron Man 2, Daredevil, Loki)']
    slug varchar(255) [not null, unique]
    release_date date [not null, note: 'Estreno real. En series: estreno del primer episodio']
    poster_url text
    synopsis text
    created_at timestamptz [not null, default: `now()`]
    updated_at timestamptz [not null, default: `now()`]

    indexes {
        release_date [name: 'idx_titles_release_date']
        title [name: 'idx_titles_title']
        kind [name: 'idx_titles_kind']
    }

    Note: 'OBRA publicada: película, serie, corto o especial. Editar acá se refleja en todos sus ítems sin duplicar datos'
}

Table episodes {
    id int [pk, increment]
    series_id int [not null, ref: > titles.id, note: 'Debe ser un title con kind = series. ON DELETE CASCADE']
    season_number int [not null]
    episode_number int [not null]
    title varchar(255) [not null, note: 'Solo el nombre del capítulo (ej: "Now is Not the End"), SIN prefijo de serie ni SxEy']
    air_date date

    indexes {
        (series_id, season_number, episode_number) [unique, name: 'uq_episodes_series_season_number']
    }

    Note: 'Capítulos de una serie. El título completo ("Agent Carter S1E1: ...") se arma al leer'
}

// --- 2. ÍTEM VISIBLE (lo que se mira y se marca) ---

Table timeline_items {
    id int [pk, increment]
    title_id int [not null, ref: > titles.id, note: 'Obra a la que pertenece. ON DELETE CASCADE: borrar la obra borra sus ítems']
    episode_id int [unique, ref: - episodes.id, note: 'Solo si segment = episode. ON DELETE CASCADE. UNIQUE: un episodio = un ítem']
    segment item_segment [not null, default: 'full']
    label varchar(150) [note: 'Aclaración contextual: "Escena post-créditos", "Re-Release", "Super Duper Cut"']
    description text [note: 'Detalle de la escena (ej: "Pausar antes de los créditos...")']
    duration_minutes int [not null, note: 'CHECK (duration_minutes > 0). Duración de ESTE segmento']
    universe_id int [not null, ref: > universes.id, note: 'ON DELETE RESTRICT. Se define por ítem: What If...? cambia de Tierra por episodio']
    created_at timestamptz [not null, default: `now()`]
    updated_at timestamptz [not null, default: `now()`]

    indexes {
        title_id [name: 'idx_items_title']
        universe_id [name: 'idx_items_universe']
        segment [name: 'idx_items_segment']
    }

    Note: '''
    Elemento indivisible de la cronología. Reglas que Drizzle expresa con check()/uniqueIndex():
    - CHECK ((episode_id IS NOT NULL) = (segment = 'episode'))
    - CHECK (duration_minutes > 0)
    - UNIQUE parcial (title_id, segment) WHERE segment IN ('full', 'main')
      -> una obra no tiene dos cuerpos principales
    '''
}

Table timeline_item_notes {
    id int [pk, increment]
    item_id int [not null, ref: > timeline_items.id, note: 'ON DELETE CASCADE']
    content text [not null, note: 'Markdown (negritas, links, formato enriquecido)']
    is_spoiler boolean [not null, default: false, note: 'La nota revela spoilers de la trama']
    order_index int [not null, default: 0, note: 'Orden si hay varias notas para el mismo ítem']
    created_at timestamptz [not null, default: `now()`]

    indexes {
        item_id [name: 'idx_notes_item']
    }

    Note: 'Notas y recomendaciones contextuales para el espectador'
}

// --- 3. POSICIÓN (orden cronológico, desacoplado del ítem) ---

Table timelines {
    id int [pk, increment]
    slug varchar(100) [not null, unique, note: 'chronological, release-order, doomsday-prep...']
    name varchar(150) [not null]
    description text
    is_default boolean [not null, default: false, note: 'UNIQUE parcial WHERE is_default: solo uno es el default']

    Note: 'Un orden de visualización. Hoy hay uno (cronológico); mañana orden de estreno o listas curadas sin tocar el resto del modelo'
}

Table timeline_entries {
    timeline_id int [not null, ref: > timelines.id, note: 'ON DELETE CASCADE']
    item_id int [not null, ref: > timeline_items.id, note: 'ON DELETE CASCADE']
    order_key text [not null, note: 'Fractional Indexing. Usar COLLATE "C" (comparación por bytes) o el ORDER BY sale desordenado']

    indexes {
        (timeline_id, item_id) [pk]
        (timeline_id, order_key) [unique, name: 'uq_entries_timeline_order']
        item_id [name: 'idx_entries_item']
    }

    Note: 'Posición de un ítem en un timeline. Reordenar = actualizar UNA fila'
}

// --- RELACIONES M:N DE LA OBRA ---

Table title_production_studios {
    title_id int [not null, ref: > titles.id, note: 'ON DELETE CASCADE']
    studio_id int [not null, ref: > production_studios.id, note: 'ON DELETE RESTRICT']

    indexes {
        (title_id, studio_id) [pk]
        studio_id [name: 'idx_title_studios_studio']
    }

    Note: 'Una obra puede tener múltiples productoras (ej: Marvel Studios + Sony). Se carga UNA vez por obra, no por episodio'
}

Table title_platforms {
    title_id int [not null, ref: > titles.id, note: 'ON DELETE CASCADE']
    platform_id int [not null, ref: > platforms.id, note: 'ON DELETE RESTRICT']

    indexes {
        (title_id, platform_id) [pk]
        platform_id [name: 'idx_title_platforms_platform']
    }

    Note: 'Una obra puede estar en múltiples plataformas (ej: Cine + Disney+)'
}

Table title_tags {
    title_id int [not null, ref: > titles.id, note: 'ON DELETE CASCADE']
    tag_id int [not null, ref: > tags.id, note: 'ON DELETE CASCADE']
    is_spoiler boolean [not null, default: false, note: 'Asociar este tag es spoiler (ej: Red Skull en Infinity War)']

    indexes {
        (title_id, tag_id) [pk]
        tag_id [name: 'idx_title_tags_tag']
    }

    Note: 'Tags de la obra (personajes, equipos, fases, sagas) con flag de spoiler contextual'
}

// --- SEGUIMIENTO DE USUARIO ---

Table user_watch_progress {
    user_id uuid [not null, ref: > users.id, note: 'ON DELETE CASCADE']
    item_id int [not null, ref: > timeline_items.id, note: 'ON DELETE CASCADE']
    status watch_status [not null, default: 'watched', note: 'watched (visto) o skipped (salteado)']
    watched_at timestamptz [not null, default: `now()`, note: 'Fecha y hora en que se marcó']

    indexes {
        (user_id, item_id) [pk]
        item_id [name: 'idx_progress_item']
    }

    Note: 'Marca por ítem. La ausencia de fila = pendiente. La PK compuesta reemplaza al uuid + unique anterior'
}
